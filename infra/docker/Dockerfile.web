# syntax=docker/dockerfile:1
# The Next.js web app (standalone output). Build context: apps/web.  Non-root, meant to run read-only (compose mounts a tmpfs for
# /tmp and the Next cache). MEMORYLAB_PUBLISHABLE_KEY is the PUBLIC key and may be baked in or given at run time.
FROM node:26-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG MEMORYLAB_PUBLISHABLE_KEY=build-placeholder
ENV MEMORYLAB_PUBLISHABLE_KEY=${MEMORYLAB_PUBLISHABLE_KEY} NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:26-slim
LABEL memorylab.owner="memorylab" memorylab.role="web"
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
# npm, npx and corepack are build tools (and carry their own dependency tree that scanners report): the runtime image runs `node server.js` only
# --only-upgrade zlib1g: the Debian base (node:26-slim is Debian 13) can lag the security repository (scanners report the gap until the base is rebuilt)
# hadolint ignore=DL3008 # one Debian security update, taken as published
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade zlib1g && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/.next/static ./.next/static
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
